# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# ── Virtual environments ─────────────────────────────────────────────────────
venv/
venv3810/
env/
.env/
.venv/

# ── Environment & secrets ────────────────────────────────────────────────────
.env
*.env
pytavia_settings/config.py
slapz102_settings/config.py
slapz102_core/config.py

# ── Certificates & private keys ──────────────────────────────────────────────
*.pem
*.key
*.p12
*.crt
*.pfx
credentials*.json
service_account*.json

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
*.log.*

# ── Node / Tailwind build ────────────────────────────────────────────────────
node_modules/

# ── Compiled Tailwind output (regenerated by build) ──────────────────────────
# static/v2/platform.output.css
# static/v2/perumahan.output.css
# (commented out — include in repo so deployment works without a build step)

# ── User-uploaded media (large binaries, not source code) ────────────────────
static/audio/*
static/images/*
!static/audio/.gitkeep
!static/images/.gitkeep

# ── OS & editor junk ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# ── Pytest / coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Flask instance folder ────────────────────────────────────────────────────
instance/
